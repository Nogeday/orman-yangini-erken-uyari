# Bu dosyayı simulation/.env olarak kopyalayın ve doldurun. .env asla commit edilmez.
# Gerçek kurumlara (OGM / İtfaiye / Muhtarlık) hiçbir ileti gönderilmez; Telegram yalnızca ekibin kendi kanalına.

# Telegram bildirimi (isteğe bağlı). Boş bırakılırsa kapalı.
# Token: Telegram'da @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Hedef(ler), virgülle: kanal/grup kimliği (-100…) ya da herkese açık kanal (@kanal_adi)
# Bulmak için: simulation/.venv/bin/python simulation/tools/telegram_test.py --sohbetler
TELEGRAM_CHAT_ID=
# Mesajın ardından konum iğnesi de gitsin mi (1/0)
TELEGRAM_SEND_PIN=1
