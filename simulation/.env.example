# İsteğe bağlı: olay mesajını EKİBİN KENDİ Telegram sohbetine gönder.
# Bu dosyayı simulation/.env olarak kopyalayın ve doldurun. .env asla commit edilmez.
# Boş bırakılırsa özellik kapalıdır. Gerçek kurumlara hiçbir ileti gönderilmez.
#
# Bot: Telegram'da @BotFather → /newbot → token
# Sohbet kimliği: bota bir mesaj yazın, sonra https://api.telegram.org/bot<TOKEN>/getUpdates → "chat":{"id":…}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
